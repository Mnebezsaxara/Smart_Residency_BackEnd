# Copy to .env on the server (next to docker-compose.yml) and fill in real values.
# docker compose reads this file automatically.

# Postgres password (pick any strong string)
DB_PASSWORD=change-me-strong-password

# JWT signing secret (any long random string)
JWT_SECRET=change-me-long-random-secret

# Public address of the backend (used to build upload URLs)
BASE_URL=http://YOUR_SERVER_IP:8080

# HiveMQ Cloud (same values you used locally)
HIVEMQ_URL=ssl://xxxxx.s1.eu.hivemq.cloud:8883
HIVEMQ_USERNAME=
HIVEMQ_PASSWORD=
HIVEMQ_CLIENT_ID=smartresidency-backend

# Gmail SMTP for password reset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
