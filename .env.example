DATABASE_URL=postgres://postgres:1234@localhost:5432/smartresidency?sslmode=disable
JWT_SECRET=replace-me
PORT=8080
BASE_URL=http://localhost:8080
HIVEMQ_URL=ssl://your-cluster.hivemq.cloud:8883
HIVEMQ_USERNAME=
HIVEMQ_PASSWORD=
HIVEMQ_CLIENT_ID=smartresidency-backend
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Gmail SMTP — для отправки 6-значного кода восстановления пароля.
# Если оставить SMTP_HOST пустым, бэкенд работает в DryRun-режиме: коды печатаются
# в лог сервера. Это удобно для разработки. Для production нужны все 5 переменных.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
